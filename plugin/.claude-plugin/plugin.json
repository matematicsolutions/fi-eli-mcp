{
  "name": "fi-eli-mcp",
  "description": "Finnish legislation with verifiable citations, from the Finlex open-data API (opendata.finlex.fi): list the statutes of a year and fetch a consolidated statute's metadata and text (Akoma Ntoso), with ELI identifiers. Every answer carries the official source, so a citation can be checked instead of trusted. Queries go only to Finlex; nothing goes to MateMatic.",
  "version": "0.3.3",
  "author": {
    "name": "Wieslaw Mazur / MateMatic Solutions"
  },
  "homepage": "https://matematicsolutions.com/en/boutique/connectors",
  "repository": "https://github.com/matematicsolutions/fi-eli-mcp",
  "documentationUrl": "https://github.com/matematicsolutions/fi-eli-mcp/tree/main/plugin#readme",
  "supportUrl": "https://github.com/matematicsolutions/fi-eli-mcp/issues",
  "privacyPolicyUrl": "https://github.com/matematicsolutions/fi-eli-mcp/tree/main/plugin#data",
  "termsOfServiceUrl": "https://github.com/matematicsolutions/fi-eli-mcp/blob/main/LICENSE",
  "license": "Apache-2.0",
  "keywords": [
    "legal",
    "finland",
    "finnish",
    "law",
    "legislation",
    "eli",
    "citations",
    "mcp"
  ],
  "mcpServers": {
    "fi-eli-mcp": {
      "command": "uvx",
      "args": [
        "fi-eli-mcp==0.3.3"
      ],
      "env": {
        "FI_ELI_RUNTIME_URL": ""
      }
    }
  }
}
